// GamePlanIQ target relational schema (PostgreSQL). The artifact build keeps the same entities as JSON documents in the
// Claude artifact database (see src/core/types.ts, the single source of truth for field names). Every tenant-owned
// model carries leagueId and an index on it; row-level security policies on leagueId are applied in migrations.
generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql"; url = env("DATABASE_URL") }

enum Role { platform_admin league_admin board_member division_commissioner head_coach assistant_coach guardian player umpire volunteer }
enum SubscriptionStatus { trial active past_due cancelled }
enum RegistrationStatus { draft submitted waitlisted pending_documents approved assigned withdrawn refunded }
enum PaymentStatus { unpaid partial paid plan assistance_requested assistance_granted refunded }
enum EventType { game practice event clinic }
enum EventStatus { scheduled postponed cancelled completed in_progress }
enum FieldStatus { open closed under_review delayed }
enum ContentStatus { draft published archived }

model User { id String @id @default(cuid()) firstName String lastName String email String @unique phone String? passwordHash String? notificationPrefs Json? createdAt DateTime @default(now()) deletedAt DateTime? memberships Membership[] guardianOf GuardianPlayer[] auditLogs AuditLog[] }
model League { id String @id @default(cuid()) slug String @unique name String shortName String city String state String charterNumber String? colors Json logoText String logoAssetId String? subdomain String @unique customDomain String? @unique timezone String contactEmail String address String? founded Int? planId String subscriptionStatus SubscriptionStatus @default(trial) trialEndsAt DateTime? renewsAt DateTime? settings Json ageGroupLabels Json createdAt DateTime @default(now()) deletedAt DateTime? memberships Membership[] seasons Season[] divisions Division[] teams Team[] players Player[] fields Field[] events ScheduleEvent[] registrations Registration[] payments Payment[] expenses Expense[] sponsors Sponsor[] announcements Announcement[] threads MessageThread[] siteContent SiteContent? plan SubscriptionPlan @relation(fields: [planId], references: [id]) }
model Membership { id String @id @default(cuid()) userId String leagueId String role Role teamIds String[] divisionIds String[] extraPermissions String[] title String? createdAt DateTime @default(now()) user User @relation(fields: [userId], references: [id]) league League @relation(fields: [leagueId], references: [id]) @@unique([userId, leagueId, role]) @@index([leagueId]) }
model SubscriptionPlan { id String @id name String monthlyPrice Int annualPrice Int description String features String[] limits Json trialDays Int featured Boolean @default(false) leagues League[] }
model Season { id String @id @default(cuid()) leagueId String name String year Int startDate DateTime endDate DateTime registrationOpens DateTime registrationCloses DateTime status String league League @relation(fields: [leagueId], references: [id]) divisions Division[] @@index([leagueId]) }
model Division { id String @id @default(cuid()) leagueId String seasonId String name String shortName String ageGroup String minLeagueAge Int maxLeagueAge Int fee Int capacity Int waitlistEnabled Boolean @default(true) curriculumId String? commissionerUserId String? description String gameLengthInnings Int baseDistanceFt Int pitchingDistanceFt Int machineOrCoachPitch String? league League @relation(fields: [leagueId], references: [id]) season Season @relation(fields: [seasonId], references: [id]) teams Team[] @@index([leagueId]) }
model Team { id String @id @default(cuid()) leagueId String seasonId String divisionId String name String color String abbreviation String headCoachUserId String? assistantCoachUserIds String[] sponsorId String? practiceSlot String? league League @relation(fields: [leagueId], references: [id]) division Division @relation(fields: [divisionId], references: [id]) players Player[] @@index([leagueId]) @@index([divisionId]) }
model Player { id String @id @default(cuid()) leagueId String firstName String lastName String displayName String birthDate DateTime leagueAge Int teamId String? divisionId String? jerseyNumber Int? positions String[] bats String throws String ageGroup String weeklyPracticeGoal Int @default(2) goals String[] consents Json createdAt DateTime @default(now()) deletedAt DateTime? league League @relation(fields: [leagueId], references: [id]) team Team? @relation(fields: [teamId], references: [id]) guardians GuardianPlayer[] registrations Registration[] completions LessonCompletion[] @@index([leagueId]) @@index([teamId]) }
model GuardianPlayer { userId String playerId String relation String? user User @relation(fields: [userId], references: [id]) player Player @relation(fields: [playerId], references: [id]) @@id([userId, playerId]) }
model Registration { id String @id @default(cuid()) leagueId String seasonId String playerId String guardianUserId String divisionId String status RegistrationStatus fee Int discounts Json amountPaid Int balance Int paymentStatus PaymentStatus documents Json waivers Json verification Json medicalNotes String? emergencyContact Json? submittedAt DateTime? updatedAt DateTime @updatedAt league League @relation(fields: [leagueId], references: [id]) player Player @relation(fields: [playerId], references: [id]) payments Payment[] @@index([leagueId, seasonId]) @@index([playerId]) }
model Payment { id String @id @default(cuid()) leagueId String registrationId String? userId String amount Int kind String method String status String processorRef String? note String? createdAt DateTime @default(now()) league League @relation(fields: [leagueId], references: [id]) registration Registration? @relation(fields: [registrationId], references: [id]) @@index([leagueId]) }
model Expense { id String @id @default(cuid()) leagueId String category String amount Int vendor String date DateTime note String? league League @relation(fields: [leagueId], references: [id]) @@index([leagueId]) }
model Field { id String @id @default(cuid()) leagueId String name String address String type String lights Boolean status FieldStatus @default(open) statusNote String? statusUpdatedAt DateTime? league League @relation(fields: [leagueId], references: [id]) events ScheduleEvent[] @@index([leagueId]) }
model ScheduleEvent { id String @id @default(cuid()) leagueId String seasonId String type EventType divisionId String? teamIds String[] homeTeamId String? awayTeamId String? fieldId String? start DateTime end DateTime status EventStatus @default(scheduled) umpireUserIds String[] title String? notes String? result Json? rescheduledFromId String? updatedAt DateTime @updatedAt league League @relation(fields: [leagueId], references: [id]) field Field? @relation(fields: [fieldId], references: [id]) attendance Attendance[] @@index([leagueId, start]) @@index([fieldId, start]) }
model Attendance { id String @id @default(cuid()) leagueId String eventId String teamId String records Json updatedAt DateTime @updatedAt event ScheduleEvent @relation(fields: [eventId], references: [id]) @@unique([eventId, teamId]) @@index([leagueId]) }
model PitchingAppearance { id String @id @default(cuid()) leagueId String playerId String teamId String eventId String? date DateTime pitches Int caughtInnings Int? recordedByUserId String @@index([leagueId, playerId, date]) }
model Volunteer { id String @id @default(cuid()) leagueId String userId String roles String[] backgroundCheckStatus String backgroundCheckExpiresAt DateTime? trainingComplete String[] availability String? @@unique([leagueId, userId]) }
model VolunteerShift { id String @id @default(cuid()) leagueId String title String kind String start DateTime end DateTime fieldId String? slots Int assignedUserIds String[] teamId String? eventId String? note String? createdByUserId String? @@index([leagueId, start]) @@index([teamId, start]) }
model Sponsor { id String @id @default(cuid()) leagueId String name String tier String amount Int contactName String contactEmail String website String? logoText String logoAssetId String? color String teamId String? status String placements String[] since Int league League @relation(fields: [leagueId], references: [id]) @@index([leagueId]) }
model Fundraiser { id String @id @default(cuid()) leagueId String title String kind String goal Int raised Int date DateTime? description String status String @@index([leagueId]) }
model Announcement { id String @id @default(cuid()) leagueId String title String body String audienceScope String audienceId String? authorUserId String publishedAt DateTime @default(now()) pinned Boolean @default(false) kind String league League @relation(fields: [leagueId], references: [id]) @@index([leagueId, publishedAt]) }
model MessageThread { id String @id @default(cuid()) leagueId String kind String title String participantUserIds String[] teamId String? divisionId String? updatedAt DateTime @updatedAt league League @relation(fields: [leagueId], references: [id]) messages Message[] reads ThreadRead[] @@index([leagueId, updatedAt]) }
model Message { id String @id @default(cuid()) threadId String authorUserId String body String sentAt DateTime @default(now()) attachmentAssetIds String[] thread MessageThread @relation(fields: [threadId], references: [id]) @@index([threadId, sentAt]) }
model ThreadRead { threadId String userId String readAt DateTime thread MessageThread @relation(fields: [threadId], references: [id]) @@id([threadId, userId]) }
model Notification { id String @id @default(cuid()) leagueId String userId String title String body String kind String link String? read Boolean @default(false) createdAt DateTime @default(now()) @@index([userId, createdAt]) }
// ---- Education content (platform-wide unless leagueId is set) ----
model Lesson { id String @id leagueId String? title String category String subcategory String ageGroups String[] skillLevel String objective String summary String video Json explanation String[] parentInstructions String[] equipment String[] equipmentFreeAlternative String? steps String[] durationMin Int commonMistakes Json cues String[] safety String[] progression Json tags String[] status ContentStatus @default(published) authorUserId String? updatedAt DateTime @updatedAt drills Drill[] completions LessonCompletion[] @@index([leagueId, category]) }
model Drill { id String @id leagueId String? name String category String skillFocus String[] ageGroups String[] skillLevels String[] equipmentRequired String[] equipmentFreeVariant String? locations String[] minSpaceFt Int participantsMin Int participantsMax Int contexts String[] durationMin Int phase String intensity String throwingLoad String setup String instructions String[] reps String cues String[] parentTip String safety String[] funVariation String lessonId String? lesson Lesson? @relation(fields: [lessonId], references: [id]) }
model ParentGuide { id String @id leagueId String? title String summary String category String ageGroups String[] pathwayStep Int? durationMin Int video Json intro String[] whatToDo String[] whatToSay String[] whatToWatchFor String[] whatToAvoid String[] ifStruggling String[] makeItFun String[] equipment String[] relatedLessonIds String[] tags String[] status ContentStatus @default(published) }
model CoachPlan { id String @id leagueId String? title String ageGroups String[] durationMin Int focus String[] playersMin Int playersMax Int coachesMin Int equipment String[] space String objective String blocks Json safety String[] progressions String[] homeAssignmentLessonId String? status ContentStatus @default(published) }
model IQLesson { id String @id leagueId String? title String topic String ageGroups String[] summary String sections Json keyTakeaways String[] questionIds String[] status ContentStatus @default(published) }
model IQQuestion { id String @id leagueId String? type String topic String lessonId String ageGroups String[] difficulty Int scenario Json? prompt String assumptions String? targets Json? options Json? explanation String animation Json? tags String[] status ContentStatus @default(published) }
model Curriculum { id String @id leagueId String? title String level String ageGroups String[] weeksCount Int summary String audience String weeks Json status ContentStatus @default(published) }
model Challenge { id String @id title String description String rule Json badgeId String ageGroups String[] points Int }
model Badge { id String @id name String description String icon String tier String }
model Resource { id String @id leagueId String? title String category String audience String[] summary String body String[] checklist String[] officialLinks Json disclaimer String? }
model GlossaryTerm { id String @id term String definition String example String relatedLessonIds String[] }
// ---- Development state ----
model LessonCompletion { id String @id @default(cuid()) leagueId String playerId String lessonId String completedAt DateTime @default(now()) byUserId String source String player Player @relation(fields: [playerId], references: [id]) lesson Lesson @relation(fields: [lessonId], references: [id]) @@unique([playerId, lessonId]) @@index([leagueId]) }
model PracticePlan { id String @id @default(cuid()) leagueId String kind String title String createdByUserId String playerId String? teamId String? params Json blocks Json totalMinutes Int safety String[] funChallenge String recap String completedAt DateTime? timesCompleted Int @default(0) favorite Boolean @default(false) createdAt DateTime @default(now()) @@index([leagueId, createdByUserId]) }
model Assignment { id String @id @default(cuid()) leagueId String teamId String? playerIds String[] lessonId String practicePlanId String? assignedByUserId String assignedAt DateTime @default(now()) dueBy DateTime? note String completions Json @@index([leagueId, teamId]) }
model IQProgress { id String @id @default(cuid()) leagueId String playerId String answers Json score Int streak Int updatedAt DateTime @updatedAt @@unique([playerId]) }
model AchievementAward { id String @id @default(cuid()) leagueId String playerId String challengeId String badgeId String awardedAt DateTime @default(now()) @@unique([playerId, challengeId]) }
model CurriculumEnrollment { id String @id @default(cuid()) leagueId String playerId String curriculumId String startedAt DateTime completedWeeks Int[] assignedBy String @@unique([playerId, curriculumId]) }
model PlayerNote { id String @id @default(cuid()) leagueId String teamId String playerId String coachUserId String body String skillChecklist Json? createdAt DateTime @default(now()) @@index([leagueId, playerId]) }
model VideoSubmission { id String @id @default(cuid()) leagueId String playerId String guardianUserId String teamId String? skill String note String storageKey String? fileName String? sizeBytes Int? uploadedAt DateTime @default(now()) status String consentConfirmed Boolean retentionUntil DateTime feedback Json @@index([leagueId, teamId, status]) }
model GuideProgress { id String @id @default(cuid()) leagueId String userId String guideId String completedAt DateTime @default(now()) @@unique([userId, guideId]) }
model Favorite { id String @id @default(cuid()) leagueId String userId String itemType String itemId String @@unique([userId, itemType, itemId]) }
model Playlist { id String @id @default(cuid()) leagueId String userId String title String lessonIds String[] createdAt DateTime @default(now()) }
model FinancialScenario { id String @id @default(cuid()) leagueId String name String inputs Json presetId String? createdByUserId String createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@index([leagueId]) }
model SiteContent { leagueId String @id hero Json about String[] faq Json policies Json documents Json boardMembers Json contact Json sectionsOrder String[] galleryNote String updatedAt DateTime @updatedAt updatedByUserId String? league League @relation(fields: [leagueId], references: [id]) }
model Tryout { id String @id @default(cuid()) leagueId String seasonId String divisionId String title String date DateTime startTime String fieldId String? status String evaluatorUserIds String[] stations String[] notes String? createdByUserId String updatedAt DateTime @updatedAt evaluations Evaluation[] @@index([leagueId, seasonId]) }
model Evaluation { id String @id @default(cuid()) leagueId String tryoutId String playerId String evaluatorUserId String scores Json notes String updatedAt DateTime @updatedAt tryout Tryout @relation(fields: [tryoutId], references: [id]) @@unique([tryoutId, playerId, evaluatorUserId]) @@index([leagueId]) }
model Draft { id String @id @default(cuid()) leagueId String seasonId String divisionId String tryoutId String? title String status String teamOrder String[] rounds Int picks Json protectedPlayerIds Json rostersApplied Boolean @default(false) startedAt DateTime? completedAt DateTime? createdByUserId String updatedAt DateTime @updatedAt @@index([leagueId, seasonId]) }
model ReportCard { id String @id @default(cuid()) leagueId String teamId String playerId String seasonId String coachUserId String period String ratings Json strengths String focus String focusSkillId String? recommendedLessonIds String[] coachNote String status String createdAt DateTime @default(now()) updatedAt DateTime @updatedAt publishedAt DateTime? parentAcknowledgedAt DateTime? @@unique([playerId, teamId, seasonId, period]) @@index([leagueId, teamId]) }
model GameSheet { id String @id @default(cuid()) leagueId String eventId String @unique status String innings Json current Json lineups Json pitchers Json keeperUserId String? notes String? updatedAt DateTime @updatedAt finalizedAt DateTime? @@index([leagueId]) }
model CertModule { id String @id leagueId String? title String summary String durationMin Int required Boolean renewMonths Int audience String[] sections Json keyPoints String[] resourceIds String[] quiz Json }
model Certification { id String @id @default(cuid()) leagueId String userId String moduleId String completedAt DateTime expiresAt DateTime score Int passed Boolean attempts Int @@unique([leagueId, userId, moduleId]) @@index([leagueId, expiresAt]) }
model AllStarPool { id String @id @default(cuid()) leagueId String seasonId String divisionId String title String ageMin Int ageMax Int rosterSize Int maxNominationsPerTeam Int maxOwnPlayersOnBallot Int? minGames Int status String nominationsClose DateTime votingClose DateTime? selectedPlayerIds String[] alternatePlayerIds String[] managerUserId String? notes String? createdByUserId String updatedAt DateTime @updatedAt selectedAt DateTime? @@index([leagueId, seasonId]) }
model AllStarNomination { id String @id @default(cuid()) leagueId String poolId String playerId String teamId String nominatedByUserId String note String createdAt DateTime @default(now()) @@unique([poolId, playerId]) }
model AllStarVote { id String @id @default(cuid()) leagueId String poolId String voterUserId String teamId String playerIds String[] updatedAt DateTime @updatedAt @@unique([poolId, voterUserId]) }
model ConsentLog { id String @id @default(cuid()) leagueId String playerId String byUserId String at DateTime @default(now()) consents Json @@index([playerId]) }
model AuditLog { id String @id @default(cuid()) leagueId String? actorUserId String actorViewerId String? action String entity String entityId String? at DateTime @default(now()) detail String? actor User @relation(fields: [actorUserId], references: [id]) @@index([leagueId, at]) }
